{
  "name": "intenttrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:offline": "vite --host 127.0.0.1",
    "dev:live": "node scripts/setup.mjs live",
