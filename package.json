    "scan:secrets": "node scripts/scan-secrets.mjs",
    "schema": "tsx scripts/schema.ts"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "0.12.1",
    "agents": "0.26.0",
    "ai": "^7.0.0",
