    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "latest",
    "prettier": "3.9.9",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^8.0.0",
    "vitest": "latest",
    "wrangler": "latest",
    "ws": "8.22.0"
  },
