{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intenttrace-local",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/agents/*"],
  },
  "vars": {
    "MODE": "offline",
    "TURNSTILE_SITE_KEY": "",
    "AI_GATEWAY_ID": "",
    "MODEL_ID": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "SESSION_MODEL_LIMIT": "30",
    "DAILY_MODEL_LIMIT": "200",
  },
  "durable_objects": {
    "bindings": [
      { "name": "CaseAgent", "class_name": "CaseAgent" },
      { "name": "SESSIONS", "class_name": "SessionRegistry" },
      { "name": "BUDGET", "class_name": "BudgetGuard" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CaseAgent", "SessionRegistry", "BudgetGuard"],
    },
  ],
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "intenttrace-local-evidence" },
  ],
  "workflows": [
    {
      "binding": "INVESTIGATE",
      "name": "intenttrace-local-investigate",
      "class_name": "InvestigationWorkflow",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "limits": { "cpu_ms": 30000 },
}
