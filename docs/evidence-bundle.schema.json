{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "scopes": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "selection": {
            "type": "string",
            "enum": [
              "filtered",
              "project"
            ]
          },
          "excludeNotes": {
            "type": "boolean"
          },
          "preserveTasks": {
            "type": "boolean"
          },
          "confirmedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "type": "string",
            "enum": [
              "observed",
              "supplied"
            ]
          },
          "requirements": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^req_[1-9][0-9]?$"
                },
                "text": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 1000
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "version",
          "text",
          "selection",
          "excludeNotes",
          "preserveTasks",
          "confirmedAt",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "request",
              "scope",
              "configuration",
              "execution",
              "evidence",
              "finding"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "detail": {
            "type": "string",
            "maxLength": 4000
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "sequence": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "runId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "scopeId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "artifactIds": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,100}$"
            }
          },
          "provenance": {
            "type": "string",
            "enum": [
              "observed",
              "supplied"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "detail",
          "occurredAt",
          "receivedAt",
          "sequence",
          "artifactIds",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "runs": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "scopeId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "config": {
            "type": "object",
            "properties": {
              "selection": {
                "type": "string",
                "enum": [
                  "filtered",
                  "project"
                ]
              },
              "includeNotes": {
                "type": "boolean"
              }
            },
            "required": [
              "selection",
              "includeNotes"
            ],
            "additionalProperties": false
          },
          "artifactId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "correct",
              "divergence",
              "missing"
            ]
          },
          "modelMode": {
            "type": "string",
            "enum": [
              "live",
              "offline"
            ]
          },
          "operationId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          }
        },
        "required": [
          "id",
          "scopeId",
          "startedAt",
          "completedAt",
          "config",
          "artifactId",
          "scenario",
          "modelMode",
          "operationId"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "kind": {
            "type": "string",
            "enum": [
              "snapshot",
              "export",
              "configuration",
              "document"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content": {
            "type": "string",
            "maxLength": 900000
          },
          "mediaType": {
            "type": "string",
            "maxLength": 100
          },
          "originalSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "sha256",
          "content"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "scopes",
    "events",
    "runs",
    "artifacts"
  ],
  "additionalProperties": false
}
